generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String? @unique
  tokenVersion Int     @default(0)

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  researchSpaces ResearchSpace[]
}

model ResearchSpace {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  name              String
  researchObjective String
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastOpenedAt      DateTime @default(now())

  sources       Source[]
  conversations Conversation[]
  notes         Note[]
  notebook      Notebook?

  @@index([ownerId])
}

enum OriginType {
  UserCreated
  SavedAssistantAnswer
}

enum SourceType {
  File
  Web
  Manual
}

enum ProcessingState {
  added
  extracting_text
  indexing_evidence
  ready
  failed
}

model Source {
  id                String          @id @default(uuid())
  researchSpaceId   String
  researchSpace     ResearchSpace   @relation(fields: [researchSpaceId], references: [id])
  sourceType        SourceType
  title             String
  author            String?
  sourceUrl         String?
  fileName          String?
  fileSize          BigInt?
  fileType          String?
  fileHash          String?
  pageCount         Int?
  characterCount    Int?
  originalNoteId    String?
  originalNote      Note?           @relation("SourceFromNote", fields: [originalNoteId], references: [id])
  content           String
  structuredContent Json?
  processingState   ProcessingState @default(added)
  processingError   String?
  retrievalIndexRef String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  citations Citation[]
  passages  Passage[]

  @@index([researchSpaceId])
  @@index([originalNoteId])
}

model Passage {
  id              String                      @id @default(uuid())
  sourceId        String
  source          Source                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content         String
  embedding       Unsupported("vector(1536)")
  searchVector    Unsupported("tsvector")
  tokenCount      Int
  strategyVersion String
  locator         Json
  createdAt       DateTime                    @default(now())

  @@index([sourceId])
}

model Conversation {
  id                   String        @id @default(uuid())
  researchSpaceId      String
  researchSpace        ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  title                String
  messages             Json          @default("[]")
  activeRetrievalScope Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  notes Note[]

  @@index([researchSpaceId])
}

model Note {
  id                   String        @id @default(uuid())
  researchSpaceId      String
  researchSpace        ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  title                String
  content              String
  /// Plain-text projection of `content`, derived server-side on write. Search
  /// runs against this so a query cannot match the markup's tag names.
  contentText          String        @default("")
  originType           OriginType
  originConversationId String?
  originConversation   Conversation? @relation(fields: [originConversationId], references: [id])
  originMessageId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sourcesCreated     Source[]       @relation("SourceFromNote")
  citationReferences NoteCitation[]

  @@index([researchSpaceId])
  @@index([originConversationId])
}

model Notebook {
  id              String        @id @default(uuid())
  researchSpaceId String        @unique
  researchSpace   ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Citation {
  id                 String   @id @default(uuid())
  sourceId           String
  source             Source   @relation(fields: [sourceId], references: [id])
  supportingPassage  String
  pageReference      String?
  paragraphReference String?
  sectionReference   String?
  passageLocator     String?
  createdAt          DateTime @default(now())

  noteReferences NoteCitation[]

  @@index([sourceId])
}

model NoteCitation {
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id])
  citationId String
  citation   Citation @relation(fields: [citationId], references: [id])

  @@id([noteId, citationId])
  @@index([citationId])
}
