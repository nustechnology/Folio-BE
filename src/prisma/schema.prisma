generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String? @unique
  tokenVersion Int     @default(0)

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  researchSpaces ResearchSpace[]
}

model ResearchSpace {
  id                String   @id @default(uuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  name              String
  researchObjective String
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastOpenedAt      DateTime @default(now())

  sources       Source[]
  conversations Conversation[]
  notes         Note[]
  notebook      Notebook?

  @@index([ownerId])
}

enum OriginType {
  UserCreated
  SavedAssistantAnswer
}

enum SourceType {
  File
  Web
  Manual
}

enum ProcessingState {
  added
  extracting_text
  indexing_evidence
  ready
  failed
}

model Source {
  id                String          @id @default(uuid())
  researchSpaceId   String
  researchSpace     ResearchSpace   @relation(fields: [researchSpaceId], references: [id])
  sourceType        SourceType
  title             String
  author            String?
  sourceUrl         String?
  fileName          String?
  fileSize          BigInt?
  fileType          String?
  fileHash          String?
  pageCount         Int?
  characterCount    Int?
  originalNoteId    String?
  originalNote      Note?           @relation("SourceFromNote", fields: [originalNoteId], references: [id])
  content           String
  structuredContent Json?
  processingState   ProcessingState @default(added)
  processingError   String?
  retrievalIndexRef String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  citations Citation[]
  passages  Passage[]

  @@index([researchSpaceId])
  @@index([originalNoteId])
  // Ingestion looks a file up by checksum before parsing, so this is read once
  // per uploaded file whether or not a match exists.
  @@index([fileHash])
}

model Passage {
  id              String                      @id @default(uuid())
  sourceId        String
  source          Source                      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content         String
  embedding       Unsupported("vector(1024)")
  // Postgres GENERATED ALWAYS ... STORED column, added by raw SQL in migration
  // 20260803023353_add_search_vector. Prisma cannot express a generated column,
  // so the expression is declared here as a database-level default. Without it
  // `prisma migrate dev` sees drift on every run and emits
  // `ALTER COLUMN "searchVector" DROP DEFAULT`, which Postgres rejects with
  // "column ... is a generated column" and leaves a failed migration behind.
  searchVector    Unsupported("tsvector")     @default(dbgenerated("to_tsvector('english'::regconfig, content)"))
  tokenCount      Int
  strategyVersion String
  locator         Json
  createdAt       DateTime                    @default(now())

  @@index([sourceId])
  // Both indexes are created by raw SQL: `Passage_embedding_idx` is HNSW with
  // vector_cosine_ops (migration 20260811120000_embedding_model_bge_m3) and
  // `Passage_searchVector_idx` is GIN. Prisma cannot express an HNSW method,
  // but declaring the indexes keeps their names in the model so migrate stops
  // trying to DROP them — an unnoticed drop would silently degrade retrieval to
  // sequential scans.
  @@index([embedding])
  @@index([searchVector], type: Gin)
}

model Conversation {
  id                   String        @id @default(uuid())
  researchSpaceId      String
  researchSpace        ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  title                String
  messages             Json          @default("[]")
  activeRetrievalScope Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  notes Note[]

  @@index([researchSpaceId])
}

model Note {
  id                   String        @id @default(uuid())
  researchSpaceId      String
  researchSpace        ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  title                String
  content              String
  /// Plain-text projection of `content`, derived server-side on write. Search
  /// runs against this so a query cannot match the markup's tag names.
  contentText          String        @default("")
  originType           OriginType
  originConversationId String?
  originConversation   Conversation? @relation(fields: [originConversationId], references: [id])
  originMessageId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sourcesCreated     Source[]       @relation("SourceFromNote")
  citationReferences NoteCitation[]

  @@index([researchSpaceId])
  @@index([originConversationId])
}

model Notebook {
  id              String        @id @default(uuid())
  researchSpaceId String        @unique
  researchSpace   ResearchSpace @relation(fields: [researchSpaceId], references: [id])
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Citation {
  id                 String   @id @default(uuid())
  sourceId           String
  source             Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  supportingPassage  String
  pageReference      String?
  paragraphReference String?
  sectionReference   String?
  passageLocator     String?
  /// Passage the citation was drawn from. Deliberately not a foreign key:
  /// re-ingesting a source replaces its passages, and a saved note must keep
  /// its evidence even when the id it points at no longer resolves.
  passageId          String?
  createdAt          DateTime @default(now())

  noteReferences NoteCitation[]

  @@index([sourceId])
}

model NoteCitation {
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id])
  citationId String
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)
  /// Rank the citation held in the answer it was saved from. The note body
  /// carries plain `[n]` markers, so this is what makes marker *n* resolvable
  /// back to a row — a set with no order would resolve them arbitrarily.
  position   Int      @default(0)

  @@id([noteId, citationId])
  @@index([citationId])
}
