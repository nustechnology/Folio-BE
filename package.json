{
  "name": "nus-express-template",
  "version": "0.0.0",
  "scripts": {
    "build": "yarn db:generate && tsc --build --clean && tsc && tsc-alias",
    "lint": "eslint src/**/*.ts --fix --no-warn-ignored",
    "start": "node dist/index.js",
    "dev": "yarn db:generate && tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/ingestion.worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate-prod": "npx prisma migrate deploy",
    "db:seed": "tsx src/prisma/seeds/space.seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1099.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.3",
    "@langchain/textsplitters": "^1.0.1",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.17.1",
    "file-type": "^22.0.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.9.2",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "mdast-util-to-string": "^4.0.0",
    "multer": "1.4.5-lts.1",
    "openai": "^6.49.0",
    "p-limit": "^7.3.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.7.3",
    "reflect-metadata": "^0.1.13",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "unified": "^11.0.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/joi": "^17.2.3",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^2.0.16",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
