NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://nus:nus_local_password@localhost:5432/nus_express_template
JWT_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=30d
SEED_USER_PASSWORD=password123

# MinIO object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=folio-sources
MINIO_USE_SSL=false

# Temp directory for multer uploads (defaults to OS temp dir)
MULTER_TEMP_DIR=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Model Gateway (OpenAI-compatible)
MODEL_EMBEDDING_BASE_URL=https://api.openai.com/v1
MODEL_EMBEDDING_API_KEY=<your-embedding-api-key>
MODEL_EMBEDDING_MODEL=text-embedding-3-small
MODEL_EMBEDDING_DIMENSIONS=1536
MODEL_REQUEST_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=1

# Semantic chunking
CHUNK_PRE_SPLIT_TOKENS=160
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
CHUNK_BREAKPOINT_PERCENTILE=90
CHUNK_EMBED_BATCH_SIZE=64
CHUNK_STRATEGY_VERSION=langchain-semantic-v1

# Optional Docker Compose overrides
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=folio-db
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379
