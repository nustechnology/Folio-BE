NODE_ENV=
PORT=
LOG_LEVEL=
DATABASE_URL=
JWT_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRATION=
REFRESH_TOKEN_EXPIRATION=
SEED_USER_PASSWORD=
# Comma-separated browser origins allowed to call this API, matched exactly.
# Required in production. Development defaults to http://localhost:3000 and
# additionally accepts any HTTPS ngrok/Cloudflare tunnel origin.
CORS_ORIGIN=

# MinIO object storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
MINIO_USE_SSL=

# Temp directory for multer uploads (defaults to OS temp dir)
MULTER_TEMP_DIR=

# Redis
REDIS_HOST=
REDIS_PORT=

# Model Gateway — embeddings.
#
# MODEL_EMBEDDING_DIMENSIONS must match the width of `Passage.embedding`, which
# migration 20260811120000_embedding_model_bge_m3 set to vector(1024) for
# bge-m3. Swapping the model to one of another size means writing a migration to
# alter that column too; startup fails fast if the two disagree.
#
# OpenAI-compatible, e.g. text-embedding-3-small at 1536:
# MODEL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MODEL_EMBEDDING_API_KEY=
# MODEL_EMBEDDING_MODEL=text-embedding-3-small
# MODEL_EMBEDDING_DIMENSIONS=1536

# Ollama-compatible (the default local setup). The base URL must be set: left
# blank it falls back to the OpenAI host, which would receive `bge-m3` and 404.
# The API key is unused by Ollama — the gateway substitutes a placeholder.
MODEL_EMBEDDING_BASE_URL=http://localhost:11434/v1
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_MODEL=bge-m3
MODEL_EMBEDDING_DIMENSIONS=1024

# Answer generation (OpenAI-compatible chat completions).
# Falls back to the MODEL_EMBEDDING_* host/key when left blank, so one local
# Ollama or one cloud key can serve both embeddings and generation.
MODEL_CHAT_BASE_URL=
MODEL_CHAT_API_KEY=
MODEL_CHAT_MODEL=
MODEL_CHAT_TEMPERATURE=
MODEL_CHAT_MAX_TOKENS=

MODEL_REQUEST_TIMEOUT_MS=
MODEL_MAX_RETRIES=
# Optional throttle for metered embedding providers, which bill every text
# inside a batched request separately (Gemini's free tier allows 100/min), so
# this is a texts/minute budget rather than an HTTP call count. Blank or absent
# means 90/min; set it to 0 to disable throttling entirely, which is what the
# default local model wants — a standing cap would only slow ingestion down.
MODEL_EMBEDDING_RPM=

# Gemini API key — used for PDF OCR (scanned pages). Not used for embeddings.
GEMINI_API_KEY=
OCR_CHARS_PER_PAGE_THRESHOLD=
# Deadline for one OCR call. Separate from MODEL_REQUEST_TIMEOUT_MS because OCR
# waits on a whole document rather than one completion — a long scanned PDF can
# run for minutes. Blank means 300000 (5 min).
OCR_REQUEST_TIMEOUT_MS=
# Per-source ceiling on targeted table OCR. Only the pages that look like tables
# are sent, and each one is billed, so a table-dense report costs more than a
# long one. Tables past this many pages keep their local pdfjs layout instead.
# Blank means 25.
OCR_MAX_TABLE_PAGES=

# Ask / grounded retrieval
ASK_RETRIEVAL_CANDIDATES=
ASK_RETRIEVAL_TOP_K=
ASK_HISTORY_TURNS=
ASK_SUGGESTION_CACHE_TTL_S=

# Semantic chunking
CHUNK_PRE_SPLIT_TOKENS=
CHUNK_TARGET_TOKENS=
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP_TOKENS=
CHUNK_BREAKPOINT_PERCENTILE=
CHUNK_EMBED_BATCH_SIZE=
CHUNK_STRATEGY_VERSION=

# Optional Docker Compose overrides
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
REDIS_PORT=
