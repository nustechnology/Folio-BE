# ==============================================================================
# Folio-BE environment
#
# Copy to .env and fill in the REQUIRED block. Everything below it is optional:
# blank or absent falls back to the default noted above each key, defined in
# `src/config/enviroment.ts` (or docker-compose.yml for the published ports).
#
# Do NOT put comments on the same line as a value. Docker Compose reads this
# file too, and for an empty key it takes the trailing comment as the value.
# ==============================================================================


# ==============================================================================
# REQUIRED
# ==============================================================================

# Which stack `docker compose` acts on. This repo ships no plain
# docker-compose.yml, so without this a bare `docker compose up` fails with
# "no configuration file provided" instead of guessing an environment — and on
# the VPS, where .env names docker-compose.prod.yml, it can never start the
# development stack beside production.
COMPOSE_FILE=docker-compose.dev.yml

# Postgres credentials. Compose declares NO defaults for these three, so the
# `db` container fails to start when they are blank.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=folio-db

# Token signing. The process throws at startup if either is empty.
# Generate each with: openssl rand -hex 64
JWT_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Answer generation for Ask — an OpenAI-compatible chat endpoint and its key.
#
# Set BOTH base URLs to the same hosted value. Compose's `environment:` block
# overrides MODEL_CHAT_BASE_URL with the _DOCKER variant, so setting only the
# plain one leaves containers falling back to Ollama, which does not serve this
# model — Ask then fails with a connection or 404 error that names neither.
MODEL_CHAT_BASE_URL=https://llm.nustechnology.com/v1
MODEL_CHAT_BASE_URL_DOCKER=https://llm.nustechnology.com/v1
MODEL_CHAT_API_KEY=
MODEL_CHAT_MODEL=mimo-v2.5

# PDF OCR for scanned pages. Not used for embeddings.
GEMINI_API_KEY=

# Required by the seed scripts only.
SEED_USER_PASSWORD=password123


# ==============================================================================
# OPTIONAL — defaults shown per key
# ==============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# default: debug in development, info in production
LOG_LEVEL=

# Comma-separated browser origins allowed to call this API, matched exactly.
# Required in production. Development defaults to http://localhost:3000 and
# additionally accepts any HTTPS ngrok/Cloudflare tunnel origin.
CORS_ORIGIN=

# Read by the Prisma CLI (prisma.config.ts) and by the app outside Compose.
# Inside Compose it is overridden to the `db` service hostname, so
# `docker compose exec api yarn db:migrate` ignores what is set here.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/folio-db

# --- Embeddings (local Ollama) ----------------------------------------------
# The base URL must be set: left blank it falls back to the OpenAI host, which
# would receive `bge-m3` and 404. The API key is unused by Ollama.
#
# MODEL_EMBEDDING_DIMENSIONS must match the width of `Passage.embedding`, which
# migration 20260811120000_embedding_model_bge_m3 set to vector(1024) for
# bge-m3. Swapping to a model of another size means a migration altering that
# column too; startup fails fast if the two disagree.
MODEL_EMBEDDING_BASE_URL=http://localhost:11434/v1
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_MODEL=bge-m3
MODEL_EMBEDDING_DIMENSIONS=1024

# Where containers reach the embedding model. Ollama stays on the HOST because
# Docker Desktop gives containers no Metal access.
# default: http://host.docker.internal:11434/v1
MODEL_EMBEDDING_BASE_URL_DOCKER=

# Throttle for metered embedding providers, which bill every text inside a
# batched request separately (Gemini's free tier allows 100/min), so this is a
# texts-per-minute budget rather than an HTTP call count. Blank means 90/min;
# 0 disables it, which is what the local model wants — a cap only slows it.
# Request MODEL_EMBEDDING_DIMENSIONS from the provider instead of taking its
# native width. Needed for Matryoshka models whose default is wider than the
# column (Gemini returns 3072). Leave false for Ollama, which has one width and
# may reject the parameter.
# default: false
MODEL_EMBEDDING_SEND_DIMENSIONS=

MODEL_EMBEDDING_RPM=0

# --- Model gateway tuning ---------------------------------------------------
# default: 0.1
MODEL_CHAT_TEMPERATURE=
# default: 900
MODEL_CHAT_MAX_TOKENS=
# Deadline for one chat completion.
# default: 60000
MODEL_REQUEST_TIMEOUT_MS=
# Deadline for one embedding request, multiplied by how many texts it carries,
# so a batch of CHUNK_EMBED_BATCH_SIZE gets that many times this. A CPU-bound
# local model needs seconds per text where a hosted one needs milliseconds.
# default: 20000 (20s per text)
MODEL_EMBEDDING_TIMEOUT_MS_PER_TEXT=
# default: 1
MODEL_MAX_RETRIES=

# --- Tokens -----------------------------------------------------------------
# default: 15m
ACCESS_TOKEN_EXPIRATION=
# default: 30d
REFRESH_TOKEN_EXPIRATION=

# --- Object storage and queue -----------------------------------------------
# Compose overrides MINIO_ENDPOINT and REDIS_HOST with its service hostnames,
# so those two only matter outside Compose. The MinIO credentials are read by
# both the app and the `minio` service, and their defaults agree.
#
# default: localhost   (Compose: minio)
MINIO_ENDPOINT=
# default: 9000
MINIO_PORT=
# default: minioadmin
MINIO_ROOT_USER=
# default: minioadmin
MINIO_ROOT_PASSWORD=
# default: folio-sources — created at API boot by ensureBucket()
MINIO_BUCKET_NAME=
# default: false
MINIO_USE_SSL=
# default: the OS temp dir
MULTER_TEMP_DIR=
# default: localhost   (Compose: redis)
REDIS_HOST=
# default: 6379
REDIS_PORT=

# --- Host ports published by Compose ----------------------------------------
# default: 5432 — 5433 avoids colliding with a Postgres already on 5432
POSTGRES_PORT=5433
# default: 9000
MINIO_API_PORT=
# default: 9001
MINIO_CONSOLE_PORT=

# --- OCR --------------------------------------------------------------------
# default: 50
OCR_CHARS_PER_PAGE_THRESHOLD=
# Deadline for one OCR call. Separate from MODEL_REQUEST_TIMEOUT_MS because OCR
# waits on a whole document rather than one completion — a long scanned PDF can
# run for minutes.
# default: 300000 (5 min)
OCR_REQUEST_TIMEOUT_MS=
# Per-source ceiling on targeted table OCR. Only pages that look like tables are
# sent, and each is billed, so a table-dense report costs more than a long one.
# Tables past this many pages keep their local pdfjs layout.
# default: 25
OCR_MAX_TABLE_PAGES=

# --- Ask / grounded retrieval -----------------------------------------------
# CANDIDATES per branch of the hybrid search; TOP_K survive fusion and become
# the evidence the answer may cite.
# default: 40
ASK_RETRIEVAL_CANDIDATES=
# default: 6
ASK_RETRIEVAL_TOP_K=
# default: 6
ASK_HISTORY_TURNS=
# default: 3600
ASK_SUGGESTION_CACHE_TTL_S=

# --- Semantic chunking ------------------------------------------------------
# default: 160
CHUNK_PRE_SPLIT_TOKENS=
# default: 500
CHUNK_TARGET_TOKENS=
# default: 800
CHUNK_MAX_TOKENS=
# default: 80
CHUNK_OVERLAP_TOKENS=
# default: 90
CHUNK_BREAKPOINT_PERCENTILE=
# Texts per embedding request. Each costs a model pass, so on a CPU-bound local
# model a big batch becomes one very long request; several small ones are safer
# and round trips are cheap. Raise it for a hosted provider.
# default: 8
CHUNK_EMBED_BATCH_SIZE=
# default: langchain-semantic-v1
CHUNK_STRATEGY_VERSION=
# Ingestion jobs processed at once. Set to 1 when embeddings run on a local
# model with few cores: it serializes them anyway, so a second job adds no
# throughput and doubles how long each embedding request waits.
# default: 2
INGESTION_CONCURRENCY=

# --- Seeds ------------------------------------------------------------------
# default: alice@example.com
SEED_USER_EMAIL=
# Seeds refuse to run when NODE_ENV=production unless this is exactly 'true'.
# Only for a non-production deployment running the production image.
ALLOW_SEED=
