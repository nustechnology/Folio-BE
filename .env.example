NODE_ENV=
PORT=
LOG_LEVEL=
DATABASE_URL=
JWT_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRATION=
REFRESH_TOKEN_EXPIRATION=
SEED_USER_PASSWORD=

# MinIO object storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
MINIO_USE_SSL=

# Temp directory for multer uploads (defaults to OS temp dir)
MULTER_TEMP_DIR=

# Redis
REDIS_HOST=
REDIS_PORT=

# Model Gateway — embeddings (any OpenAI-compatible /v1/embeddings endpoint).
# Defaults to Gemini: gemini-embedding-2 truncated (MRL) to 1536 dimensions,
# which is the width the Passage.embedding column is declared as. Leave
# MODEL_EMBEDDING_API_KEY empty to reuse GEMINI_API_KEY below.
# Changing MODEL_EMBEDDING_MODEL/DIMENSIONS needs a matching Prisma migration
# on Passage.embedding plus a full re-index (`yarn reingest`).
MODEL_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_MODEL=gemini-embedding-2
MODEL_EMBEDDING_DIMENSIONS=1536

# Model Gateway (Ollama-compatible — local alternative)
# MODEL_EMBEDDING_BASE_URL=http://localhost:11434/v1
# MODEL_EMBEDDING_API_KEY=ollama
# MODEL_EMBEDDING_MODEL=nomic-embed-text
# MODEL_EMBEDDING_DIMENSIONS=768

MODEL_REQUEST_TIMEOUT_MS=
MODEL_MAX_RETRIES=
# Embedding requests per minute allowed by the provider. Gemini counts every
# text inside a batched request separately, so this is a texts/minute budget
# (free tier gemini-embedding-2 = 100/min; default 90 leaves headroom).
MODEL_EMBEDDING_RPM=

# Gemini API key — used for embeddings (above) and PDF OCR
GEMINI_API_KEY=
OCR_CHARS_PER_PAGE_THRESHOLD=

# Semantic chunking
CHUNK_PRE_SPLIT_TOKENS=
CHUNK_TARGET_TOKENS=
CHUNK_MAX_TOKENS=
CHUNK_OVERLAP_TOKENS=
CHUNK_BREAKPOINT_PERCENTILE=
CHUNK_EMBED_BATCH_SIZE=
CHUNK_STRATEGY_VERSION=

# Optional Docker Compose overrides
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
REDIS_PORT=
