{
  "compilerOptions": {
    "module": "Preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "rootDir": "./src",
    "sourceMap": true,
    "outDir": "dist",
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ],
}
